{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f pyproject.toml ]; then ruff check --fix --quiet 2>/dev/null || true; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
