# ⚠️ DEPRECATED: v2.2부터 forge.toml 대신 .env + pyproject.toml [tool.forge]를 사용합니다.
# 이 파일은 하위 호환성을 위해 유지되지만, 새 프로젝트에서는 forge init을 실행하세요.
# 비밀(토큰, 키)은 .env에, 공유 설정은 pyproject.toml [tool.forge]에 저장하세요.

[forge]
# ── Telegram ──
telegram_bot_token = ""
telegram_chat_id = ""

# ── 비용 예산 (분) ──
max_sprint_minutes = 180
max_generator_minutes = 120

# ── Langfuse (하네스 메타 추적, 선택) ──
langfuse_public_key = ""
langfuse_secret_key = ""
langfuse_host = "https://cloud.langfuse.com"

# ── Claude Code CLI 턴 제한 ──
planner_max_turns = 15
planner_review_max_turns = 10
contract_max_turns = 12
evaluator_max_turns = 20

# ── Playwright ──
playwright_enabled = true
playwright_timeout_seconds = 600
