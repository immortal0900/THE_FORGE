# THE FORGE — 프로젝트 고유값 (이 파일은 예시. 실제는 .env로 복사)
#
# v2.4: 토큰/채널 등 모든 프로젝트가 공유하는 값은 ~/.forge/config.env에서 로드됩니다.
#       `forge setup`으로 전역 설정 파일을 만드세요.
#       이 .env는 프로젝트별 override용입니다.
#
# ── 필수 ─────────────────────────────────────────────
FORGE_PROJECT_NAME="my_project"

# ── 선택: 이 프로젝트만 다른 값을 쓸 때 주석 해제 ─────
# FORGE_NOTIFIER_BACKEND="telegram"   # telegram | slack
# FORGE_BOT_DISPLAY_NAME=""            # 비워두면 "Forge-{PascalCase(project_name)}"
# FORGE_BOT_EMOJI=":hammer_and_wrench:"

# ── Slack (보통 ~/.forge/config.env에 전역 설정) ──────
# FORGE_SLACK_BOT_TOKEN="xoxb-..."
# FORGE_SLACK_APP_TOKEN="xapp-..."
# FORGE_SLACK_CHANNEL="C01ABC..."

# ── Telegram (프로젝트별 저장. 전역 공유 미권장 — 봇당 1 인스턴스 제약) ──
# FORGE_TELEGRAM_BOT_TOKEN=""
# FORGE_TELEGRAM_CHAT_ID=""

# ── Langfuse (보통 ~/.forge/config.env에 전역 설정) ───
# FORGE_LANGFUSE_PUBLIC_KEY=""
# FORGE_LANGFUSE_SECRET_KEY=""
# FORGE_LANGFUSE_HOST="https://cloud.langfuse.com"
